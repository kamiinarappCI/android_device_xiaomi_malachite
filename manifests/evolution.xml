<?xml version="1.0" encoding="UTF-8"?>
<!--
     Local manifest for building Evolution X (Android 17, manifest branch
     cnb) for malachite entirely from the malachite-project forks. Copy to
     .repo/local_manifests/evolution.xml after

       repo init -u https://github.com/Evolution-X/manifest.git -b cnb

     Written 2026-10-29, ported from lineage-24.0.

     Evolution X mounts its own vendor tree at vendor/lineage and carries
     its own forks of frameworks/base, frameworks/native, Settings,
     Telephony and Bluetooth. Those five are overridden here with
     evolutionx-24.0 branches: Evolution X cnb plus the malachite
     commits of our lineage-24.0 forks, so Evolution X's own features stay.
     Left out because Evolution X already has its own version: the
     three-finger screenshot (its ThreeFingersSwipeListener), the market
     device name and the screenshot flash switch.

     The device tree and those five use evolutionx-24.0. Every
     other fork stays on lineage-24.0. These carry changes on top of their
     source:
       device tree         the Evolution X port: this manifest and the
                           Evolution X options in lineage_malachite.mk,
                           on top of lineage-24.0
       frameworks/native   Evolution X cnb + the layout-safe GED KPI
                           implementation (GED state outside Surface),
                           Dolby Vision HDR reporting, FPSGO hooks and
                           the BnProducerListener detach ABI symbol
       frameworks/base     Evolution X cnb + unrounded backlight, timed
                           brightness ramps, hwui FPSGO hooks, call volume
                           index to the HAL, QS pulldown, UDFPS canvas
                           clear, no screenshot flash by default, FaceSense
                           challenge fix
       Settings            Evolution X cnb + shared SIM / eUICC selection,
                           refresh rate list fixes, battery saver CPU limit
       Telephony           Evolution X cnb + shared SIM / eUICC selection
       Bluetooth           Evolution X cnb + the LE Audio fixes
       wpa_supplicant_8    current LineageOS + CONFIG_DISABLE_WPA_VERSION_3
                           (the shipped MTK driver ignores WPA3; the
                           framework switch is off by default) + the
                           soong flag declaration Evolution X's copy,
                           taken from LineageOS, does not have
       hardware/mediatek   current LineageOS + chara's Codec2 AIDL
                           service, memtrack hardening and the MediaTek
                           wpa_supplicant driver-command library
                           (lib_driver_cmd_mt66xx), with the
                           wpa_supplicant NAN struct fix (3be5c41)
       hardware/xiaomi     current LineageOS + chara's malachite eUICC,
                           mtdservice, fingerprint and sensor fixes
       sepolicy_vndr       current LineageOS + chara's six MT6878 labels
                           and radio-property rules
       vendor              chara + Aperture kept beside MiuiCamera
                           (QR scanner)
     malachite-kernel and vendor/mediatek/ims are chara's release state,
     unmodified. Face unlock is stock's mifaced HAL from the
     device and vendor trees; no face unlock app is added.
     hardware/dolby is crDroid's LunarisDolby branch reduced
     to its Dolby control app; the Dolby DAX vendor stack comes from
     stock 208 in vendor/xiaomi/malachite.

     Kernel sources are built separately; see kernel_manifest-6.1.
-->
<manifest>
  <remote name="malachite-project" fetch="https://github.com/malachite-project/" />

  <!-- Device -->
  <remove-project path="device/xiaomi/malachite" optional="true" />
  <project path="device/xiaomi/malachite" name="android_device_xiaomi_malachite" remote="malachite-project" revision="evolutionx-24.0" />
  <remove-project path="device/xiaomi/malachite-kernel" optional="true" />
  <project path="device/xiaomi/malachite-kernel" name="android_device_xiaomi_malachite-kernel" remote="malachite-project" revision="lineage-24.0" />
  <remove-project path="vendor/xiaomi/malachite" optional="true" />
  <project path="vendor/xiaomi/malachite" name="proprietary_vendor_xiaomi_malachite" remote="malachite-project" revision="lineage-24.0" />

  <!-- Platform: not in Evolution X's manifest, added -->
  <remove-project path="hardware/mediatek" optional="true" />
  <project path="hardware/mediatek" name="android_hardware_mediatek" remote="malachite-project" revision="lineage-24.0" />
  <remove-project path="hardware/xiaomi" optional="true" />
  <project path="hardware/xiaomi" name="android_hardware_xiaomi" remote="malachite-project" revision="lineage-24.0" />
  <remove-project path="device/mediatek/sepolicy_vndr" optional="true" />
  <project path="device/mediatek/sepolicy_vndr" name="android_device_mediatek_sepolicy_vndr" remote="malachite-project" revision="lineage-24.0" />
  <remove-project path="vendor/mediatek/ims" optional="true" />
  <project path="vendor/mediatek/ims" name="android_vendor_mediatek_ims" remote="malachite-project" revision="lineage-24.0" />
  <remove-project path="hardware/dolby" optional="true" />
  <project path="hardware/dolby" name="android_hardware_dolby" remote="malachite-project" revision="lineage-24.0" />

  <!-- Overrides of LineageOS's supplicant and Evolution X's framework forks -->
  <remove-project path="external/wpa_supplicant_8" optional="true" />
  <project path="external/wpa_supplicant_8" name="android_external_wpa_supplicant_8" remote="malachite-project" revision="lineage-24.0" />
  <remove-project path="frameworks/base" optional="true" />
  <project path="frameworks/base" name="android_frameworks_base" remote="malachite-project" revision="evolutionx-24.0" groups="pdk-cw-fs,pdk-fs,sysui-studio" />
  <remove-project path="frameworks/native" optional="true" />
  <project path="frameworks/native" name="android_frameworks_native" remote="malachite-project" revision="evolutionx-24.0" groups="pdk" />
  <remove-project path="packages/apps/Settings" optional="true" />
  <project path="packages/apps/Settings" name="android_packages_apps_Settings" remote="malachite-project" revision="evolutionx-24.0" groups="pdk-fs,pdk-cw-tvc,sysui-studio" />
  <remove-project path="packages/services/Telephony" optional="true" />
  <project path="packages/services/Telephony" name="android_packages_services_Telephony" remote="malachite-project" revision="evolutionx-24.0" groups="pdk-cw-fs,pdk-fs" />
  <remove-project path="packages/modules/Bluetooth" optional="true" />
  <project path="packages/modules/Bluetooth" name="android_packages_modules_Bluetooth" remote="malachite-project" revision="evolutionx-24.0" groups="pdk" />
</manifest>
