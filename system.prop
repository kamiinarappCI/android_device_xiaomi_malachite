# Bluetooth
# Developer options "Disable Bluetooth LE audio": sets
# persist.bluetooth.leaudio_switcher.disabled, and the Bluetooth app turns the
# LE Audio profiles off on its next start. Here, not in vendor.prop: the
# property has no own SELinux label, so it is default_prop, which
# vendor_init may not set.
ro.bluetooth.leaudio_switcher.supported=true

# A2DP hardware offload coex for MediaTek (LineageOS packages/modules/Bluetooth
# d7165dd2088): while A2DP is offloaded, L2CAP keeps 3 of the controller's
# classic ACL buffers free and the stack tells the controller so (A2DP vendor
# command, sub-opcode 0xA0), so other classic links cannot starve the
# offloaded stream. 0 (unset) skips both. persist.bluetooth.* is
# bluetooth_prop, which vendor_init may not set.
persist.bluetooth.a2dp_offload.coex_buf_count=3

# WiFi
wifi.interface=wlan0
wifi.supplicant_scan_interval=120

# mistos prop
ro.mist.display=1220 x 2712, 120 hz
ro.mist.battery=5110mAh
ro.mist.soc=Mediatek Dimenshity 7300-Ultra
ro.mist.camera=200/50MP + 8MP + 2MP
ro.mist.front=20MP
ro.mist.platform=MT6878
ro.mist.screen=6.67’ Amoled 
ro.mist.device.name=Malachite
